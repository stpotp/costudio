local function bindHover(button, base, hover)
	button.MouseEnter:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = hover}):Play()
	end)
	button.MouseLeave:Connect(function()
		TweenService:Create(button, TweenInfo.new(0.15), {BackgroundColor3 = base}):Play()
	end)
end

bindHover(executeBtn, Color3.fromRGB(124, 140, 246), Color3.fromRGB(142, 156, 255))
bindHover(copyBtn, Color3.fromRGB(35, 35, 43), Color3.fromRGB(46, 46, 56))
